# Ignore the heavy data subfolders
data/
data/archive/
archive/

# Local secrets for `docker run --env-file` (CDS API key, Azure Blob
# connection string) - never committed, never baked into any image
secrets.env

# DSSAT-CSM binary tree staged locally for `docker build` (COPY'd into the
# image, never committed - extract dssat-v4.8.1.40.tar.gz here, see Dockerfile)
dssat-bin/

# Ad-hoc assessment scratch folder (copied source rasters, not repo data)
nigeria_maize_season_assessment/

**/*.nc

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp
.DS_Store

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Exploratory scripts
main/DSSAT/package_dashboard_app_for_laptop.R
check_n_points_in_region.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Jupyter server files
*.ipynb_checkpoints

# Local Blob test data, pipeline logs and rendered README preview
blob_test_data/
run_logs/
README.html
